FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    make \
    g++ \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    perl \
    libxml-simple-perl \
    libjson-perl \
    liblist-moreutils-perl \
  && rm -rf /var/lib/apt/lists/*

# Bracken (install_bracken.sh compiles src/kmer2read_distr via `make` — without this,
# bracken-build silently no-ops: it falls back to a PATH-search branch with an unquoted
# `[ -f $(command -v generate_kmer_distribution.py) ]` that evaluates true even when not
# found, running `python -i <kraken-report>` instead and exiting 0 with no output file)
RUN git clone --depth 1 --branch "v3.1" https://github.com/jenniferlu717/Bracken.git /opt/bracken \
 && cd /opt/bracken && bash install_bracken.sh

# Krona
RUN git clone --depth 1 --branch "v2.8.1" https://github.com/marbl/Krona.git /opt/krona-src \
 && cd /opt/krona-src/KronaTools \
 && ./install.pl --prefix /opt/krona

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    coreutils \
    findutils \
    gzip \
    pigz \
    tar \
    unzip \
    curl \
    wget \
    git \
    jq \
    gcc \
    python3 \
    python3-pip \
    perl \
    libxml-simple-perl \
    libjson-perl \
    liblist-moreutils-perl \
    samtools \
    minimap2 \
    kraken2 \
    default-jre \
    fastqc \
    libnuma1 \
    libhdf5-dev \
    libgomp1 \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/bracken /opt/bracken
COPY --from=builder /opt/krona /opt/krona

# bracken-build hardcodes the unversioned `python` command; symlink it explicitly rather
# than relying on the miniforge install later in this file to happen to provide one.
RUN install -d /usr/local/bin \
  && ln -sf /opt/bracken/bracken /usr/local/bin/bracken \
  && ln -sf /opt/bracken/bracken-build /usr/local/bin/bracken-build \
  && ln -sf /usr/bin/python3 /usr/local/bin/python \
  && ln -sf /opt/krona/bin/ktImportText /usr/local/bin/ktImportText \
  && ln -sf /opt/krona/bin/ktImportTaxonomy /usr/local/bin/ktImportTaxonomy \
  && ln -sf /opt/krona/bin/ktImportBLAST /usr/local/bin/ktImportBLAST \
  && ln -sf /opt/krona/bin/ktImportXML /usr/local/bin/ktImportXML

# Install Python packages for lr_amp pipeline
RUN python3 -m pip install --no-cache-dir \
    "multiqc==1.25.1" \
    NanoFilt \
    matplotlib \
    numpy \
    pandas \
    pysam \
    biopython \
    pod5

# Install Emu via conda (miniforge for arm64 support)
RUN curl -L https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-aarch64.sh -o /tmp/miniforge.sh \
    && bash /tmp/miniforge.sh -b -p /opt/miniforge \
    && rm /tmp/miniforge.sh \
    && /opt/miniforge/bin/conda install -y -c conda-forge -c bioconda emu \
    && /opt/miniforge/bin/conda clean -afy \
    && ln -sf /opt/miniforge/bin/emu /usr/local/bin/emu

# Install Dorado for basecalling (Linux ARM64 version)
RUN curl -L https://cdn.oxfordnanoportal.com/software/analysis/dorado-1.0.0-linux-arm64.tar.gz -o /tmp/dorado.tar.gz \
    && mkdir -p /opt/dorado \
    && tar -xzf /tmp/dorado.tar.gz -C /opt/dorado --strip-components=1 \
    && rm /tmp/dorado.tar.gz \
    && ln -sf /opt/dorado/bin/dorado /usr/local/bin/dorado

ENV PATH="/opt/miniforge/bin:${PATH}"

WORKDIR /work
